<?xml version='1.0' encoding='utf-8'?>
<interface version="1.2">
  <object class="tk.Toplevel" id="toplevel1">
    <property name="geometry">480x680</property>
    <property name="minsize">480|680</property>
    <property name="title" translatable="yes">PDF Analytics</property>
    <child>
      <object class="ttk.Label" id="input">
        <property name="font">TkHeadingFont</property>
        <property name="text" translatable="yes">Input</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.25</property>
          <property name="rely">0.05</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="output">
        <property name="font">TkHeadingFont</property>
        <property name="text" translatable="yes">Output</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.75</property>
          <property name="rely">0.05</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator1">
        <property name="orient">vertical</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relheight">0.62</property>
          <property name="relx">0.50</property>
          <property name="rely">0.42</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="analyze">
        <property name="command" type="command" cbtype="simple">on_analyze_item_clicked</property>
        <property name="text" translatable="yes">Analyze</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.50</property>
          <property name="relx">0.50</property>
          <property name="rely">0.895</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Progressbar" id="progressBar">
        <property name="mode">determinate</property>
        <property name="orient">horizontal</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.80</property>
          <property name="relx">0.50</property>
          <property name="rely">0.96</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="pygubu.builder.widgets.pathchooserinput" id="PDFDirPath">
        <property name="image">ellipsis-icon.png</property>
        <property name="mustexist">true</property>
        <property name="title" translatable="yes">Select PDF Directory</property>
        <property name="type">directory</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.35</property>
          <property name="relx">0.25</property>
          <property name="rely">0.18</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="pygubu.builder.widgets.pathchooserinput" id="filterDirPath">
        <property name="image">ellipsis-icon.png</property>
        <property name="title" translatable="yes">Select Filter File</property>
        <property name="type">file</property>
        <bind sequence="&lt;&lt;PathChooserPathChanged&gt;&gt;" handler="on_filterFilePathChanged" add="" />
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.35</property>
          <property name="relx">0.75</property>
          <property name="rely">0.33</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator2">
        <property name="orient">horizontal</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.45</property>
          <property name="relx">0.25</property>
          <property name="rely">0.23</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="pygubu.builder.widgets.pathchooserinput" id="keywordDirPath">
        <property name="image">ellipsis-icon.png</property>
        <property name="title" translatable="yes">Select Keyword File</property>
        <property name="type">file</property>
        <bind sequence="&lt;&lt;PathChooserPathChanged&gt;&gt;" handler="on_keywordFilePathChanged" add="" />
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.35</property>
          <property name="relx">0.25</property>
          <property name="rely">0.33</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="keywordOrBox">
        <property name="text" translatable="yes">OR</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.25</property>
          <property name="rely">0.38</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="filterOrBox">
        <property name="text" translatable="yes">OR</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.75</property>
          <property name="rely">0.38</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="selectPDFDirLabel">
        <property name="font">TkTextFont</property>
        <property name="text" translatable="yes">Select PDF Directory</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.25</property>
          <property name="rely">0.12</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="selectFilterLabel">
        <property name="font">TkTextFont</property>
        <property name="text" translatable="yes">Select Filter File</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.75</property>
          <property name="rely">0.27</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="selectKeywordLabel">
        <property name="font">TkTextFont</property>
        <property name="text" translatable="yes">Select Keyword File</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.25</property>
          <property name="rely">0.27</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Text" id="manualFilters">
        <property name="font">TkTextFont</property>
        <property name="foreground">#83838B</property>
        <property name="height">10</property>
        <property name="relief">flat</property>
        <property name="takefocus">false</property>
        <property name="text" translatable="yes">!
@
#
$</property>
        <property name="width">50</property>
        <property name="wrap">none</property>
        <bind sequence="&lt;FocusIn&gt;" handler="on_enter_manualFilters" add="" />
        <bind sequence="&lt;KeyRelease&gt;" handler="on_manualFilterEntry" add="" />
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relheight">0.30</property>
          <property name="relwidth">0.40</property>
          <property name="relx">0.75</property>
          <property name="rely">0.57</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="tk.Text" id="manualKeywords">
        <property name="font">TkTextFont</property>
        <property name="foreground">#83838B</property>
        <property name="height">10</property>
        <property name="text" translatable="yes">Washington
State
Ratify
Kentucky</property>
        <property name="width">50</property>
        <property name="wrap">none</property>
        <bind sequence="&lt;FocusIn&gt;" handler="on_enter_manualKeywords" add="" />
        <bind sequence="&lt;KeyRelease&gt;" handler="on_manualKeywordEntry" add="" />
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relheight">0.30</property>
          <property name="relwidth">0.40</property>
          <property name="relx">0.25</property>
          <property name="rely">0.57</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Separator" id="separator3">
        <property name="orient">horizontal</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.45</property>
          <property name="relx">0.75</property>
          <property name="rely">0.23</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Frame" id="frame1">
        <property name="height">80</property>
        <property name="width">200</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.75</property>
          <property name="rely">0.135</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
        <child>
          <object class="ttk.Label" id="contextLengthBox">
            <property name="font">TkTextFont</property>
            <property name="text" translatable="yes">Context Paragraph Length:</property>
            <layout manager="place">
              <property name="anchor">nw</property>
              <property name="x">0</property>
              <property name="y">22</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Entry" id="contextLengthEntry">
            <property name="font">TkTextFont</property>
            <property name="text" translatable="yes">30</property>
            <property name="textvariable">string:contextLengthVar</property>
            <property name="validate">key</property>
            <property name="validatecommand" type="command" cbtype="entry_validate" args="%P">check_ContextLengthEntry</property>
            <layout manager="place">
              <property name="anchor">nw</property>
              <property name="height">22</property>
              <property name="width">30</property>
              <property name="x">165</property>
              <property name="y">22</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Label" id="genericFilterLabel">
            <property name="font">TkTextFont</property>
            <property name="text" translatable="yes">Basic Letter/Number Filter:</property>
            <layout manager="place">
              <property name="anchor">nw</property>
              <property name="x">0</property>
              <property name="y">60</property>
            </layout>
          </object>
        </child>
        <child>
          <object class="ttk.Checkbutton" id="basicFilterCheckbox">
            <property name="command" type="command" cbtype="simple">on_basicFilter_clicked</property>
            <property name="offvalue">0</property>
            <property name="onvalue">1</property>
            <property name="variable">int:basicFilterState</property>
            <layout manager="place">
              <property name="anchor">nw</property>
              <property name="x">175</property>
              <property name="y">60</property>
            </layout>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="pygubu.builder.widgets.pathchooserinput" id="outputDirPath">
        <property name="image">ellipsis-icon.png</property>
        <property name="mustexist">true</property>
        <property name="title" translatable="yes">Select Output Directory</property>
        <property name="type">directory</property>
        <bind sequence="&lt;&lt;PathChooserPathChanged&gt;&gt;" handler="on_keywordFilePathChanged" add="" />
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relwidth">0.50</property>
          <property name="relx">0.50</property>
          <property name="rely">0.82</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="selectOutputLabel">
        <property name="text" translatable="yes">Select Output Directory</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.5</property>
          <property name="rely">0.77</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
  </object>
  <object class="tk.Menu" id="menuBar">
    <property name="font">TkMenuFont</property>
    <property name="tearoff">false</property>
    <child>
      <object class="tk.Menuitem.Submenu" id="subMenuFile">
        <property name="font">TkMenuFont</property>
        <property name="label" translatable="yes">File</property>
        <property name="tearoff">false</property>
        <child>
          <object class="tk.Menuitem.Command" id="subMenuAboutButton">
            <property name="command" type="command" cbtype="simple">on_about_item_clicked</property>
            <property name="font">TkMenuFont</property>
            <property name="label" translatable="yes">About PDFAnalytics</property>
          </object>
        </child>
        <child>
          <object class="tk.Menuitem.Command" id="subMenuHelpButton">
            <property name="command" type="command" cbtype="simple">on_help_item_clicked</property>
            <property name="font">TkMenuFont</property>
            <property name="label" translatable="yes">Help</property>
          </object>
        </child>
        <child>
          <object class="tk.Menuitem.Separator" id="separator4" />
        </child>
        <child>
          <object class="tk.Menuitem.Command" id="subMenuQuitButton">
            <property name="command" type="command" cbtype="simple">on_quit_item_clicked</property>
            <property name="label" translatable="yes">Quit</property>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="pygubu.builder.widgets.dialog" id="aboutDialog">
    <property name="geometry">450x280</property>
    <property name="height">280</property>
    <property name="minsize">450|280</property>
    <property name="resizable">none</property>
    <property name="title" translatable="yes">About PDF Analytics</property>
    <property name="width">450</property>
    <child>
      <object class="ttk.Label" id="productNameAndVersionLabel">
        <property name="font">{TkHeadingFont 16} 20 {}</property>
        <property name="text" translatable="yes">PDF Analytics v.3</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="x">192</property>
          <property name="y">20</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="logoImageLabel">
        <property name="image">starNymph.png</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="x">15</property>
          <property name="y">15</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="aboutBlurbLabel">
        <property name="text" translatable="yes">Software by Caldwell Research Analytics
Copyright © 2022 James Caldwell
Patent pending</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="x">170</property>
          <property name="y">75</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Label" id="OSSLicenseAcknowledgementLabel">
        <property name="text" translatable="yes">PDF Analytics uses the following open source libraries:
Matplotlib - Copyright © 2012 - 2022 The Matplotlib Development Team
pdftotext - Copyright © 2017 Jason Alan Palmer
pygubu - Copyright © 2020 Alejandro Autalán</property>
        <layout manager="place">
          <property name="anchor">nw</property>
          <property name="relx">0.02</property>
          <property name="rely">0.56</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
    <child>
      <object class="ttk.Button" id="viewLicensesButton">
        <property name="command" type="command" cbtype="simple">on_viewLicenses_item_clicked</property>
        <property name="text" translatable="yes">View Licenses</property>
        <layout manager="place">
          <property name="anchor">center</property>
          <property name="relx">0.50</property>
          <property name="rely">0.90</property>
          <property name="x">0</property>
          <property name="y">0</property>
        </layout>
      </object>
    </child>
  </object>
  <object class="pygubu.builder.widgets.dialog" id="licenseDialog">
    <property name="height">600</property>
    <property name="maxsize">600|600</property>
    <property name="minsize">600|600</property>
    <property name="resizable">none</property>
    <property name="width">600</property>
    <child>
      <object class="pygubu.builder.widgets.tkinterscrolledtext" id="licenseTerms">
        <property name="padx">10</property>
        <property name="pady">10</property>
        <property name="state">disabled</property>
        <property name="tabstyle">tabular</property>
