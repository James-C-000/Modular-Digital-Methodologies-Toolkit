# Direct runtime dependencies of MDMT.
# Compiled into per-platform lock files (requirements/lock-*.txt) by
# requirements/compile.sh; CI and release builds install from the locks.
# llama-cpp-python is pinned separately in requirements/llama.txt.
matplotlib~=3.10
ocrmypdf~=17.3
faster-whisper~=1.2
# Offline translation (Argos packages on CTranslate2) and language detection
sentencepiece~=0.2
sacremoses~=0.2
py3langid~=0.4
# NER and RAG retrieval run on ONNX Runtime with Hugging Face tokenizers (no torch)
onnxruntime~=1.31
tokenizers~=0.22
# av 19 removed the metadata_errors= argument that faster-whisper 1.2.1 passes to av.open()
av>=16,<19
nicegui~=3.8
# Native window on Windows/macOS only; Linux runs in the user's browser.
pywebview~=6.1; sys_platform != 'linux'
platformdirs~=4.3
huggingface_hub~=1.3
networkx~=3.6
psutil~=7.0
# Runtime dependencies of llama-cpp-python (installed with --no-deps from
